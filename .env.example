# ===== App =====
NODE_ENV=development
PORT=8080

# ===== Database =====
DATABASE_URL=
DATABASE_POOL_URL=

# ===== JWT =====
JWT_SECRET=
JWT_ACCESS_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=1209600

# ===== Kakao OAuth =====
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://ofq37ku3ma.execute-api.ap-northeast-2.amazonaws.com/api/auth/kakao/callback

# ===== Google OAuth =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ofq37ku3ma.execute-api.ap-northeast-2.amazonaws.com/api/auth/google/callback

# ===== Frontend (OAuth 성공 후 토큰 전달 대상) =====
FRONTEND_URL=https://playona-five.vercel.app

# ===== Track 메타데이터 외부 API =====
# Spotify Web API (Client Credentials) / YouTube Data API v3
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=

# ===== Share link =====
SHARE_BASE_URL=https://playona-five.vercel.app

# ===== Optional S3 profile images =====
# Lambda uses its IAM role; local runs require AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_PUBLIC_BASE_URL=

# ===== Optional AI matching (same switches as Spring dev) =====
AI_MATCHING_MODE=off
OPENAI_API_KEY=
AI_MATCHING_MODEL=gpt-4o-mini
# Per warm Lambda instance, not a deployment-wide quota. 0 means unlimited.
AI_MATCHING_MAX_REQUESTS=20
